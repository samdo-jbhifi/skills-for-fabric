model Model
	culture: en-AU
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-AU
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

/// Here you can group values used throughout your semantic model for convenient use! These parameters can also be changed from the PBI service!
queryGroup Parameters

	annotation PBI_QueryGroupOrder = 0

/// Here you can group the main Fact tables in your STAR schema
queryGroup Facts

	annotation PBI_QueryGroupOrder = 1

/// Here you can group the main Dimension tables in your STAR schema
queryGroup Dimensions

	annotation PBI_QueryGroupOrder = 2

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Metrics","Country","Date Group","Extra Care Salesperson","Date","Primary Products","Selling Channel","Store","Sales and Return Errors","Datasource","Warehouse","Database","PBI User Security","COUNTRY_ID","EC Products","Kada Param","Kada Widget"]

annotation PBI_ProTooling = ["WebModelingEdit","DevMode"]

ref table Metrics
ref table Country
ref table 'Date Group'
ref table 'Extra Care Salesperson'
ref table Date
ref table 'Primary Products'
ref table 'Selling Channel'
ref table Store
ref table 'Sales and Return Errors'
ref table 'PBI User Security'
ref table 'Metrics (FP)'
ref table 'Dimensions (FP)'
ref table 'EC Products'
ref table 'Kada Widget'

ref cultureInfo en-AU

