	measure 'Most Recent Data Refresh' = ```
			VAR RefreshedDateTime = CALCULATE(MAX('Sales and Return Errors'[Written Sales Date]), ALL())
			
			RETURN "Data refreshed as at: " & FORMAT(RefreshedDateTime,"DD/MM/YYYY", "en-US")
			    
			```
		displayFolder: 00. Metadata
		lineageTag: 8fa234e4-edee-4cc0-8a85-134a93a0fbd5

	measure 'Report Tooltip' = ```
			
			    VAR _WrittenReference = SWITCH(TRUE(),
			                   ISFILTERED('Sales and Return Errors'[Written Reference]) && DISTINCTCOUNTNOBLANK('Sales and Return Errors'[Written Reference])>1, UNICHAR(10) & "Written Reference : " & CONCATENATEX(VALUES('Sales and Return Errors'[Written Reference]), 'Sales and Return Errors'[Written Reference]," , "),
			                   DISTINCTCOUNTNOBLANK('Sales and Return Errors'[Written Reference])>1,  UNICHAR(10) & "Written Reference : All",
			                   UNICHAR(10) & "Written Reference : " & MAX('Sales and Return Errors'[Written Reference]))
				VAR _Exception = SWITCH(TRUE(),
								ISFILTERED('Sales and Return Errors'[Discrepancy - Summarised]) && DISTINCTCOUNTNOBLANK('Sales and Return Errors'[Discrepancy - Summarised])>1, UNICHAR(10) & "Exception  : " & CONCATENATEX(VALUES('Sales and Return Errors'[Discrepancy - Summarised]), 'Sales and Return Errors'[Discrepancy - Summarised], " , "),
								DISTINCTCOUNTNOBLANK('Sales and Return Errors'[Discrepancy - Summarised])>1,  UNICHAR(10) & "Exception : All",
								UNICHAR(10) & "Exception : " & MAX('Sales and Return Errors'[Discrepancy - Summarised]))
				VAR _Resolved = SWITCH(TRUE(),
								ISFILTERED('Sales and Return Errors'[Reversed Transaction]) && DISTINCTCOUNTNOBLANK('Sales and Return Errors'[Reversed Transaction])>1, UNICHAR(10) & "Resolved : " & CONCATENATEX(VALUES('Sales and Return Errors'[Reversed Transaction]), 'Sales and Return Errors'[Reversed Transaction], " , "),
								DISTINCTCOUNTNOBLANK('Sales and Return Errors'[Reversed Transaction])>1,  UNICHAR(10) & "Resolved : All",
								UNICHAR(10) & "Resolved : " & MAX('Sales and Return Errors'[Reversed Transaction]))
				VAR _Area = SWITCH(TRUE(),
								ISFILTERED('Store'[Area Desc]) && DISTINCTCOUNTNOBLANK('Store'[Area Desc])>1, UNICHAR(10) & "Area : " & CONCATENATEX(VALUES('Store'[Area Desc]), 'Store'[Area Desc], " , "),
								DISTINCTCOUNTNOBLANK('Store'[Area Desc])>1,  UNICHAR(10) & "Area : All",
								UNICHAR(10) & "Area : " & MAX('Store'[Area Desc]))
				VAR _Store = SWITCH(TRUE(),
								ISFILTERED('Store'[Store Name]) && DISTINCTCOUNTNOBLANK('Store'[Store Name])>1, UNICHAR(10) & "Store : " & CONCATENATEX(VALUES('Store'[Store Name]),'Store'[Store Name]," , "),
								DISTINCTCOUNTNOBLANK('Store'[Store Name])>1,  UNICHAR(10) & "Store : All",
								UNICHAR(10) & "Store : " & MAX('Store'[Store Name]))
				VAR _SalesChannel = SWITCH(TRUE(),
								ISFILTERED('Selling Channel'[Sale Channel]) && DISTINCTCOUNTNOBLANK('Selling Channel'[Sale Channel])>1, UNICHAR(10) & "Sale Channel : " & CONCATENATEX(VALUES('Selling Channel'[Sale Channel]), 'Selling Channel'[Sale Channel], " , "),
								DISTINCTCOUNTNOBLANK('Selling Channel'[Sale Channel])>1,  UNICHAR(10) & "Sale Channel : All",
								UNICHAR(10) & "Sale Channel : " & MAX('Selling Channel'[Sale Channel]))
				VAR _SubSalesChannel = SWITCH(TRUE(),
								ISFILTERED('Selling Channel'[Sub Sale Channel]) && DISTINCTCOUNTNOBLANK('Selling Channel'[Sub Sale Channel])>1, UNICHAR(10) & "Sub Sale Channel : " & CONCATENATEX(VALUES('Selling Channel'[Sub Sale Channel]), 'Selling Channel'[Sub Sale Channel], " , "),
								DISTINCTCOUNTNOBLANK('Selling Channel'[Sub Sale Channel])>1,  UNICHAR(10) & "Sub Sale Channel : All",
								UNICHAR(10) & "Sub Sale Channel : " & MAX('Selling Channel'[Sub Sale Channel]))
				VAR _DateGroup = SWITCH(TRUE(),
								ISFILTERED('Date Group'[Date Group Desc]) && DISTINCTCOUNTNOBLANK('Date Group'[Date Group Desc])>1, UNICHAR(10) & "Date Group : " & CONCATENATEX(VALUES('Date Group'[Date Group Desc]),'Date Group'[Date Group Desc]," , "),
								DISTINCTCOUNTNOBLANK('Date Group'[Date Group Desc])>1,  UNICHAR(10) & "Date Group : All",
								UNICHAR(10) & "Date Group : " & MAX('Date Group'[Date Group Desc]))
				VAR _Date = SWITCH(TRUE(),
								ISFILTERED('Date'[DATE_KEY]) && DISTINCTCOUNTNOBLANK('Date'[DATE_KEY])>1, UNICHAR(10) & "Date : " & MIN('Date'[DATE_KEY]) & " to " & MAX('Date'[DATE_KEY]),
								DISTINCTCOUNTNOBLANK('Date'[DATE_KEY])>1,  UNICHAR(10) & "Date : All",
								UNICHAR(10) & "Date : " & MAX('Date'[DATE_KEY]))
				
			RETURN
				_WrittenReference & _Exception & _Resolved & _Area & _Store & _SalesChannel & _SubSalesChannel & _DateGroup & _Date
			
			```
		displayFolder: 00. Metadata
		lineageTag: 2728b956-b356-458a-80d1-c4c82e6ad218

