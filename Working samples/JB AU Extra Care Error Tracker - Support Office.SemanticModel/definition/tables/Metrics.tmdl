	measure 'Report Footer Text' = ```
			
			
			// VAR _LOB = IF(ISFILTERED('Country'[Country Description]), MAX('Country'[Country Code]),"All")
			VAR _Resolved = IF(ISFILTERED('Sales and Return Errors'[Reversed Transaction]), DISTINCTCOUNTNOBLANK('Sales and Return Errors'[Reversed Transaction]),"All")
			VAR _Exception = IF(ISFILTERED('Sales and Return Errors'[Discrepancy - Summarised]), DISTINCTCOUNTNOBLANK('Sales and Return Errors'[Discrepancy - Summarised]),"All")
			VAR _Area = IF(ISFILTERED('Store'[Area Desc]), DISTINCTCOUNTNOBLANK('Store'[Area Desc]),"All")
			VAR _WrittenReference = IF(ISFILTERED('Sales and Return Errors'[Written Reference]), DISTINCTCOUNTNOBLANK('Sales and Return Errors'[Written Reference]),"All")
			VAR _SalesChannel = IF(ISFILTERED('Selling Channel'[Sale Channel]), DISTINCTCOUNTNOBLANK('Selling Channel'[Sale Channel]),"All")
			VAR _SubSalesChannel = IF(ISFILTERED('Selling Channel'[Sub Sale Channel]), DISTINCTCOUNTNOBLANK('Selling Channel'[Sub Sale Channel]),"All")
			VAR _DateGroup = IF(ISFILTERED('Date Group'[Date Group Desc]), IF( DISTINCTCOUNTNOBLANK('Date Group'[Date Group Desc]) = 1, MAX('Date Group'[Date Group Desc]), "Many"),"All")
			VAR _Date = IF(ISFILTERED('Date'[DATE_KEY]), MIN('Date'[DATE_KEY]) & " to " & MAX('Date'[DATE_KEY]),"All")
			VAR _Store = IF(ISFILTERED('Store'[Store Name]), DISTINCTCOUNTNOBLANK('Store'[Store Name]),"All")
			  
			RETURN
			
			"Written Reference : " & _WrittenReference & " ,
			Exception : " & _Exception & " ,
			Resolved : " & _Resolved & " ,
			Area : " & _Area & " ,
			Store : " & _Store & " ,
			Sales Channel : " & _SalesChannel & " ,
			Sub Sales Channel : " & _SubSalesChannel & " ,
			Date Group : " & _DateGroup & " ,
			Date : " & _Date 
			
			
			
			
			
			
			
			 
			```
		displayFolder: 00. Metadata
		lineageTag: f539a7ac-d74e-48ba-82e5-31f4467f13f7

