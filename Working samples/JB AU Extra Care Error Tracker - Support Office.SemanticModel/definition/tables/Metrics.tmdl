	measure 'Multiple Errors' =
			
			
			VAR _Count = CALCULATE(SUMX('Sales and Return Errors', IF([Error Ineligible From Manufacturers Warranty] + [Error Overcharged Extra Care Pricing] + [Not Sold On Pda] + [ERROR_EXCLUDED_PRIMARY_STOCK_CODE] + [ERROR_INCORRECT_EXTRA_CARE_STOCK_CODE] + [Error Manual Refund] > 1, 1, 0)))
			
			RETURN _Count
		formatString: #,0
		lineageTag: 43e7c6bc-f56a-4d61-95d2-7573ad19006a

