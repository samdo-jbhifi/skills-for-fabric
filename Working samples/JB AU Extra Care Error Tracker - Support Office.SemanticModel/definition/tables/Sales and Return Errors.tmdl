	column ERROR_EXCLUDED_PRIMARY_STOCK_CODE
		dataType: int64
		lineageTag: a7282900-4c2a-4a7f-b693-b3940c23c258
		summarizeBy: sum
		sourceColumn: ERROR_EXCLUDED_PRIMARY_STOCK_CODE

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Discrepancy - Summarised' = ```
			
			
			VAR _WarrantyIneligibility = 
			    IF('Sales and Return Errors'[Error Ineligible From Manufacturers Warranty] = 1, 
			        "Ineligible Manufacturers Warranty", BLANK())
			
			VAR _WrongEC = 
			    IF('Sales and Return Errors'[ERROR_INCORRECT_EXTRA_CARE_STOCK_CODE] = 1, 
			        "Wrong EC SKU Sold", BLANK())
			
			VAR _NoServiceOrderCreated = 
			    IF('Sales and Return Errors'[Not Sold On Pda] = 1, 
			        "JBEC Not Sold on a PDA", BLANK())
			
			VAR _OverchargedEC = 
			    IF('Sales and Return Errors'[Error Overcharged Extra Care Pricing] = 1, 
			        "Incorrectly Charged for EC", BLANK())
			
			VAR _ManualRefund = 
			    IF('Sales and Return Errors'[Error Manual Refund] = 1, 
			        "Manual Refunds", BLANK())
			/*
			VAR _ExcludedReceipts = 
			    IF('Sales and Return Errors'[Error Excluded Receipt] = 1, 
			        "Excluded Receipts", BLANK())
			*/
			        VAR _ExcludedPrimaryProduct = 
			    IF('Sales and Return Errors'[ERROR_EXCLUDED_PRIMARY_STOCK_CODE] = 1, 
			        "Excluded Primary SKUs", BLANK())
			
			VAR _Discrepancy =
			    CONCATENATEX(
			        {
			            _WarrantyIneligibility,
			            _WrongEC,
			            _NoServiceOrderCreated,
			            _OverchargedEC,
			            _ManualRefund,
			            /*_ExcludedReceipts,*/
			            _ExcludedPrimaryProduct
			        },
			        [Value]
			        
			    )
			
			
			VAR _DiscrepancyCount = 
			    [Error Ineligible From Manufacturers Warranty] + 
			    [Error Overcharged Extra Care Pricing] + 
			    [Not Sold On Pda] + 
			    [ERROR_INCORRECT_EXTRA_CARE_STOCK_CODE] +
			    [Error Manual Refund] +
			    /*[Error Excluded Receipt] +*/
			    [ERROR_EXCLUDED_PRIMARY_STOCK_CODE]
			
			RETURN
			    IF(_DiscrepancyCount > 1, "Multiple", _Discrepancy)
			
			```
		lineageTag: 123c233c-e258-4890-956f-70004b87f2fe
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Total Errors Count' = ```
			[Error Ineligible From Manufacturers Warranty] + [Error Overcharged Extra Care Pricing] + [Not Sold On Pda] + [ERROR_INCORRECT_EXTRA_CARE_STOCK_CODE]  + [Error Manual Refund] + [ERROR_EXCLUDED_PRIMARY_STOCK_CODE] 
			```
		lineageTag: cd47e2d0-f389-4001-b6e1-3347da63ff79
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Listed Discrepancies' = ```
			
			
			VAR _List =
			    {
			        IF('Sales and Return Errors'[Error Ineligible From Manufacturers Warranty] = 1, 
			            "Ineligible Manufacturers Warranty", BLANK()),
			
			        IF('Sales and Return Errors'[ERROR_INCORRECT_EXTRA_CARE_STOCK_CODE] = 1, 
			            "Wrong EC SKU Sold", BLANK()),
			
			        IF('Sales and Return Errors'[Not Sold On Pda] = 1, 
			            "JBEC Not Sold on a PDA", BLANK()),
			
			        IF('Sales and Return Errors'[Error Overcharged Extra Care Pricing] = 1, 
			            "Incorrectly Charged for EC", BLANK()),
			
			        /*IF('Sales and Return Errors'[Error Excluded Receipt] = 1, 
			            "Excluded Receipts", BLANK()),*/
			        
			        IF('Sales and Return Errors'[Error Manual Refund] = 1, 
			            "Manual Refunds", BLANK()),
			
			        IF('Sales and Return Errors'[ERROR_EXCLUDED_PRIMARY_STOCK_CODE] = 1, 
			            "Excluded Primary SKUs", BLANK())
			    }
			
			RETURN
			    CONCATENATEX(
			        FILTER(_List, NOT ISBLANK([Value])),
			        [Value],
			        ", "
			    )
			
			```
		lineageTag: 1d08a7b0-2f48-46b3-b200-5687f10d8964
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

