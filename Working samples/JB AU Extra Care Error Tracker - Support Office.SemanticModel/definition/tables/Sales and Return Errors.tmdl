	column 'Return Errors' =
			
			VAR _RefundErrors =
			    IF(
			        'Sales and Return Errors'[Error Manual Refund] = 1,
			        "Manual Refunds",
			        BLANK()
			    )
			
			VAR _Discrepancy =
			    CONCATENATEX(
			        {
			            _RefundErrors
			        },
			        [Value]
			    )
			
			VAR _DiscrepancyCount =
			    [Error Manual Refund]
			
			RETURN
			    IF(_DiscrepancyCount > 1, "Multiple", _Discrepancy)
		lineageTag: aba0f905-a1bf-476d-a028-05098de113d4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Error Type' =
			
			VAR ErrorCount =
			    [Error Ineligible From Manufacturers Warranty]
			    + [Error Overcharged Extra Care Pricing]
			    + [Not Sold On Pda]
			    + [ERROR_INCORRECT_EXTRA_CARE_STOCK_CODE]
			    + [Error Manual Refund]
			    + [ERROR_EXCLUDED_PRIMARY_STOCK_CODE]
			RETURN
			    SWITCH(
			        TRUE(),
			        ErrorCount > 1, "Multiple",
			        [Error Ineligible From Manufacturers Warranty] = 1, "Manufacturers Warranty",
			        [Error Overcharged Extra Care Pricing] = 1, "Incorrectly Charged for EC",
			        [Not Sold On Pda] = 1, "JBEC Not Sold On PDA",
			        [ERROR_INCORRECT_EXTRA_CARE_STOCK_CODE] = 1, "Wrong EC SKU Sold",
			        [Error Manual Refund] = 1, "Manually Returned",
			        [ERROR_EXCLUDED_PRIMARY_STOCK_CODE] = 1, "Excluded Primary SKUs",
			        BLANK()
			    )
		lineageTag: c6406995-a547-4ecf-ad45-241fb47fa789
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

