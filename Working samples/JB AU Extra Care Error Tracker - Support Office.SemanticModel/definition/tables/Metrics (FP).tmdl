	partition 'Metrics (FP)' = calculated
		mode: import
		source = ```
				
				
				/* 
				This is a field parameter!
				You can create your own from: Modelling > New Parameter > Fields
				
				Field parameters (FP) are really great for changing the axes of a visual (by either metric or dimension, or both!).
				Also you can create additional custom columns by adding to this FP table such as below for metric units (Quantity/Dollars) which can be sliced on
				*/
				
				{
				    ("Sales Quantity",           NAMEOF('Metrics'[Sales Quantity]),           0,  "Quantity"),
				    ("Sales Quantity LY",        NAMEOF('Metrics'[Sales Quantity LY]),        1,  "Quantity"),
				    ("Sales Quantity YoY Var",   NAMEOF('Metrics'[Sales Quantity YoY Var]),   2,  "Quantity"),
				    ("Sales Quantity YoY Var %", NAMEOF('Metrics'[Sales Quantity YoY Var %]), 3,  "Quantity"),
				    ("Sales Quantity LYTD",      NAMEOF('Metrics'[Sales Quantity LYTD]),      4,  "Quantity"),
				    ("Sales Quantity YTD",       NAMEOF('Metrics'[Sales Quantity YTD]),       5,  "Quantity"),
				    ("Sales Dollars",            NAMEOF('Metrics'[Sales Dollars]),            6,   "Dollars"),
				    ("Sales Dollars LY",         NAMEOF('Metrics'[Sales Dollars LY]),         7,   "Dollars"),
				    ("Sales Dollars YoY Var",    NAMEOF('Metrics'[Sales Dollars YoY Var]),    8,   "Dollars"),
				    ("Sales Dollars YoY Var %",  NAMEOF('Metrics'[Sales Dollars YoY Var %]),  9,   "Dollars"),
				    ("Sales Dollars LYTD",       NAMEOF('Metrics'[Sales Dollars LYTD]),       10,  "Dollars"),
				    ("Sales Dollars YTD",        NAMEOF('Metrics'[Sales Dollars YTD]),        11,  "Dollars")
				}
				```

